#!/usr/bin/env bash
# camdroid - Zero-latency Android camera streamer to Linux v4l2loopback
# Powered by scrcpy and v4l2loopback

set -eo pipefail

VERSION="1.0.0"
DEFAULT_DEVICE="/dev/video3"
DEFAULT_FACING="back"
DEFAULT_SIZE="1920x1080"
DEFAULT_FPS="30"

usage() {
    cat <<EOF
camdroid v${VERSION} - Low-latency Android Camera to Linux v4l2loopback

Usage:
  camdroid [options]

Options:
  -d, --device <path>     Target v4l2loopback device (default: ${DEFAULT_DEVICE})
  -f, --facing <side>     Camera facing: back | front (default: ${DEFAULT_FACING})
  -s, --size <WxH>        Camera resolution (default: ${DEFAULT_SIZE})
  -r, --fps <val>         Frame rate (default: ${DEFAULT_FPS})
  -l, --list              List supported cameras and sensor resolutions
  --setup-v4l2            Print modprobe command to configure loopback devices
  -h, --help              Show this help message

Examples:
  camdroid
  camdroid --facing front --size 1280x720 --fps 60
  camdroid --device /dev/video4
EOF
    exit 0
}

TARGET_DEVICE="${DEFAULT_DEVICE}"
FACING="${DEFAULT_FACING}"
SIZE="${DEFAULT_SIZE}"
FPS="${DEFAULT_FPS}"
LIST_MODE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--device)
            TARGET_DEVICE="$2"
            shift 2
            ;;
        -f|--facing)
            FACING="$2"
            shift 2
            ;;
        -s|--size)
            SIZE="$2"
            shift 2
            ;;
        -r|--fps)
            FPS="$2"
            shift 2
            ;;
        -l|--list)
            LIST_MODE=1
            shift
            ;;
        --setup-v4l2)
            echo "Run this command with sudo to create loopback nodes:"
            echo "sudo modprobe v4l2loopback devices=2 video_nr=2,3 card_label=\"AI Virtual Cam\",\"Android Cam\" exclusive_caps=1,1"
            exit 0
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done

# Check prerequisites
command -v adb >/dev/null 2>&1 || { echo "[!] Error: 'adb' is not installed. Install android-tools (pacman/apt/dnf)."; exit 1; }
command -v scrcpy >/dev/null 2>&1 || { echo "[!] Error: 'scrcpy' is not installed (version >= 2.0 required)."; exit 1; }

# Verify connected device
ADB_STATE=$(adb get-state 2>/dev/null || true)
if [[ "$ADB_STATE" != "device" ]]; then
    echo "[!] No authorized Android device detected over ADB."
    echo "    1. Connect phone via USB."
    echo "    2. Enable Developer Options -> USB Debugging."
    echo "    3. Authorize connection on phone prompt."
    exit 1
fi

DEVICE_MODEL=$(adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')
echo "[✓] Connected Android device: ${DEVICE_MODEL}"

if [[ $LIST_MODE -eq 1 ]]; then
    echo "=== Listing Camera Sensors & Resolutions ==="
    scrcpy --video-source=camera --list-cameras || true
    echo ""
    scrcpy --video-source=camera --list-camera-sizes || true
    exit 0
fi

# Check target v4l2 device
if [[ ! -e "$TARGET_DEVICE" ]]; then
    echo "[!] Loopback node $TARGET_DEVICE does not exist."
    echo "    Load v4l2loopback module first:"
    echo "    sudo modprobe v4l2loopback devices=2 video_nr=2,3 card_label=\"AI Virtual Cam\",\"Android Cam\" exclusive_caps=1,1"
    exit 1
fi

echo "[🚀] Streaming ${DEVICE_MODEL} (${FACING} camera, ${SIZE} @ ${FPS}fps) -> ${TARGET_DEVICE}"
echo "[ℹ] Press Ctrl+C to terminate."

exec scrcpy \
    --video-source=camera \
    --camera-facing="${FACING}" \
    --camera-size="${SIZE}" \
    --camera-fps="${FPS}" \
    --v4l2-sink="${TARGET_DEVICE}" \
    --no-playback \
    --no-audio
